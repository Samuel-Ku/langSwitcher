#!/usr/bin/env bash
#
# pre-commit — block project-file drift before it is ever committed.
#
# Runs scripts/verify-pbxproj.py, which fails when a pbxproj entry does not
# resolve to a real file, when a source file is not referenced by the project,
# or when the test target, the LangSwitcherTests group and the directory on
# disk disagree. Xcode trusts the pbxproj, so this class of drift otherwise
# only surfaces as a CI failure on a macOS runner (see the
# "missing: Services/RecoveryPreviewView.swift" incident).
#
# Skippable for exceptional cases:  git commit --no-verify
# One-time install:                 scripts/install-hooks.sh

set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "pre-commit: verifying project file integrity…"
if python3 scripts/verify-pbxproj.py; then
  exit 0
fi

echo
echo "pre-commit: project file drift detected (see above)."
echo "  Fix the pbxproj, or bypass with: git commit --no-verify"
exit 1
